{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titlechain-foundation.github.io/icsn-standards/schemas/ricardian-service-contract.schema.json",
  "title": "M5isYOU Ricardian Service Contract",
  "type": "object",
  "required": ["id", "version", "status", "representations", "service", "consideration", "executionPolicy", "signatures"],
  "properties": {
    "id": {"type": "string", "format": "uri"},
    "version": {"type": "string"},
    "status": {"enum": ["draft", "offered", "accepted", "active", "completed", "cancelled", "disputed"]},
    "representations": {
      "type": "object",
      "required": ["human", "machine", "execution", "contentDigest"],
      "properties": {
        "human": {"type": "string", "format": "uri-reference"},
        "machine": {"type": "string", "format": "uri-reference"},
        "execution": {"type": "string", "format": "uri-reference"},
        "contentDigest": {"type": "string"}
      }
    },
    "service": {"type": "object"},
    "consideration": {"type": "object"},
    "paymentAdapter": {"type": "object"},
    "executionPolicy": {
      "type": "object",
      "required": ["automaticActions", "approvalRequired"],
      "properties": {
        "automaticActions": {"type": "array", "items": {"type": "string"}},
        "approvalRequired": {"type": "array", "items": {"type": "string"}}
      }
    },
    "signatures": {"type": "array", "items": {"type": "object"}}
  }
}
