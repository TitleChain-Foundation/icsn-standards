{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.titlechain.org/schemas/credentialed-authority-registry-v1.schema.json",
  "title": "Credentialed Authority Registry Record",
  "type": "object",
  "required": [
    "authorityRecordId",
    "principalRef",
    "role",
    "jurisdictionRef",
    "status",
    "capabilities"
  ],
  "properties": {
    "authorityRecordId": {
      "type": "string"
    },
    "entityRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "principalRef": {
      "type": "string"
    },
    "agentRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "role": {
      "type": "string"
    },
    "credentialRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "jurisdictionRef": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "suspended",
        "expired",
        "revoked",
        "under-review"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assetOrIssueScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effectiveAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "revocationRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenanceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
