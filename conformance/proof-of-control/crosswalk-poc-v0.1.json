    ]
  },
  "le_requirements": [
    {
      "id": "LE1.1",
      "level": 1,
      "title": "Agent, legal entity, accountable human and role authority on every record",
      "extends": [
        "5.1.1"
      ]
    },
    {
      "id": "LE1.2",
      "level": 2,
      "title": "Accountable human's role authority validated before a grant",
      "extends": [
        "4.1.1",
        "5.1.2"
      ]
    },
    {
      "id": "LE1.3",
      "level": 2,
      "title": "Signed human -> entity role -> agent chain with scope intersection",
      "extends": [
        "4.2.2",
        "4.2.3"
      ]
    },
    {
      "id": "LE1.4",
      "level": 1,
      "title": "Agents are never principals and cannot over-delegate",
      "extends": [
        "4.2.3"
      ]
    },
    {
      "id": "LE1.5",
      "level": 2,
      "title": "Human or entity revokes without agent or provider consent",
      "extends": [
        "4.1.2"
      ]
    },
    {
      "id": "LE1.6",
      "level": 2,
      "title": "Grants revoked or reaffirmed when the accountable human's role ends",
      "extends": [
        "4.2.2"
      ]
    },
    {
      "id": "LE2.1",
      "level": 2,
      "title": "Key rotation leaves identifiers unchanged, with linking record",
      "extends": [
        "6.3.2"
      ]
    },
    {
      "id": "LE2.2",
      "level": 2,
      "title": "A compromised key alone cannot move title, roles or delegations",
      "extends": [
        "6.3.3"
      ]
    },
    {
      "id": "LE2.3",
      "level": 2,
      "title": "Verification distinguishes event-time, deprecated and compromised-after",
      "extends": [
        "6.3.4",
        "6.3.5"
      ]
    },
    {
      "id": "LE3.1",
      "level": 3,
      "title": "Pseudonymous subject with evidence of a valid entity delegation",
      "extends": [
        "4.2.4"
      ]
    },
    {
      "id": "LE3.2",
      "level": 2,
      "title": "Pseudonym linkage held by the principal; disclosure conditions declared",
      "extends": [
        "10.2.1"
      ]
    },
    {
      "id": "LE3.3",
      "level": 2,
      "title": "Scores over pseudonymous subjects use a published method",
      "extends": [
        "7.5.1"
      ]
    },
    {
      "id": "LE4.1",
      "level": 2,
      "title": "Protected records stay in the principal-controlled store",
      "extends": [
        "1.4.1",
        "2.1.2",
        "2.4.1"
      ]
    },
    {
      "id": "LE4.2",
      "level": 2,
      "title": "Exportable verification bundle, verifiable offline",
      "extends": [
        "3.2.1",
        "8.1.5"
      ]
    },
    {
      "id": "LE4.3",
      "level": 3,
      "title": "Signed linking record across a provider move",
      "extends": [
        "3.2.2"
      ]
    },
    {
      "id": "LE5.1",
      "level": 2,
      "title": "Computation manifest; records cite manifest and parameter digests",
      "extends": [
        "7.7.1",
        "10.1.5"
      ]
    },
    {
      "id": "LE5.2",
      "level": 2,
      "title": "Time-triggered events stamped at their deadline",
      "extends": [
        "7.2.1"
      ]
    },
    {
      "id": "LE5.3",
      "level": 2,
      "title": "Canonical numbers representable identically in every language",
      "extends": [
        "7.7.2",
        "7.7.4"
      ]
    },
    {
      "id": "LE5.4",
      "level": 3,
      "title": "Two independent implementations held to shared vectors",
      "extends": [
        "7.7.4"
      ]
    },
    {
      "id": "LE6.1",
      "level": 2,
      "title": "Accountable-human approval for consequential actions",
      "extends": [
        "4.1.6"
      ]
    },
    {
      "id": "LE6.2",
      "level": 2,
      "title": "Reversible, hash-chained settlement hold",
      "extends": [
        "7.3.1"
      ]
    },
    {
      "id": "LE6.3",
      "level": 1,
      "title": "Automated responses record their rule and trigger",
      "extends": [
        "4.1.2"
      ]
    }
  ],
